# Vyapaar सेतु — Backend Environment Configuration
# Baatcheet se business tak.

# -----------------------------------------------------------------------------
# APPLICATION RUNTIME
# -----------------------------------------------------------------------------
APP_NAME="Vyapaar सेतु API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
API_V1_PREFIX="/api/v1"

# -----------------------------------------------------------------------------
# MONGODB PERSISTENCE (Local or MongoDB Atlas Cluster)
# -----------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vyapaar_setu?retryWrites=true&w=majority"
MONGODB_DATABASE="vyapaar_setu"
MONGODB_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# CORS & FRONTEND
# -----------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET_KEY="replace_with_a_secure_random_64_character_hex_string_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# -----------------------------------------------------------------------------
# VOBIZ TELEPHONY & VOICE COMMERCE (Phase 4)
# -----------------------------------------------------------------------------
# Vobiz REST Voice API Base URL (Default: https://api.vobiz.ai/api/v1)
VOBIZ_API_BASE_URL="https://api.vobiz.ai/api/v1"

# Your Vobiz Account Auth ID (starts with MA_...)
VOBIZ_AUTH_ID=""

# Your Vobiz Account Auth Token
VOBIZ_AUTH_TOKEN=""

# Optional webhook shared secret for HMAC-SHA256 signature verification
VOBIZ_WEBHOOK_SECRET=""

# Your dedicated Vobiz business virtual phone number (E.164 format, e.g. +918012345678)
VOBIZ_PHONE_NUMBER=""

# Publicly reachable tunnel URL (e.g. ngrok: https://xxxx.ngrok-free.app) for Vobiz webhooks
PUBLIC_BASE_URL="http://localhost:8000"

# Optional explicit WebSocket stream URL (defaults to PUBLIC_BASE_URL converted to wss://)
PUBLIC_WEBSOCKET_URL=""
