# Vyapaar सेतु — Backend Environment Configuration

# Application Environment
APP_NAME="Vyapaar सेतु API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
API_V1_PREFIX="/api/v1"

# MongoDB Database Configuration (Local or MongoDB Atlas cluster)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vyapaar_setu?retryWrites=true&w=majority"
MONGODB_DATABASE="vyapaar_setu"
MONGODB_TIMEOUT_MS=5000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
