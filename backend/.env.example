# Vyapaar सेतु — Backend Environment Configuration
# Baatcheet se business tak.

# Application Environment
APP_NAME="Vyapaar सेतु API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
API_V1_PREFIX="/api/v1"

# MongoDB Database Configuration (Local or MongoDB Atlas cluster)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vyapaar_setu?retryWrites=true&w=majority"
MONGODB_DATABASE="vyapaar_setu"
MONGODB_TIMEOUT_MS=5000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# JWT Authentication & Cookie Security Settings
JWT_SECRET_KEY="replace_with_a_secure_random_64_character_hex_string_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Twilio Programmable Voice & Media Streams Configuration
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_PHONE_NUMBER="+14155552671"
TWILIO_APPLICATION_SID=""
TWILIO_VALIDATE_WEBHOOK_SIGNATURE=true

# Public Domain / Tunnel URLs for Twilio Inbound Webhooks & Media Streams
# Use your active ngrok/localtunnel/Cloudflare Tunnel URL during development
PUBLIC_BASE_URL="https://your-public-domain.example"
PUBLIC_WEBSOCKET_URL="wss://your-public-domain.example"
